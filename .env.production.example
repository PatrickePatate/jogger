# Jogger production settings. Copy to .env and fill in the values marked REQUIRED.

APP_NAME=Jogger
# REQUIRED. Generate: docker run --rm ghcr.io/patrickepatate/jogger:latest php artisan key:generate --show
# Back it up: it encrypts the GitHub App key and every secret.
APP_KEY=
# REQUIRED. The public address people and GitHub use, e.g. https://ci.example.com
APP_URL=http://localhost:8000

# REQUIRED. Any long random string.
DB_PASSWORD=
DB_DATABASE=jogger
DB_USERNAME=jogger

SESSION_DRIVER=redis
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb
REDIS_CLIENT=phpredis

# REQUIRED. Two long random strings; they authenticate the server to its own websocket service.
REVERB_APP_ID=jogger
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where browsers reach the websocket service. Leave empty to use the page's own host and port
# (right behind Caddy with `--profile https`); without Caddy set the port to the published Reverb port (8080).
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=

# With `--profile https`: the domain Caddy requests a certificate for.
JOGGER_DOMAIN=

# Outgoing e-mail (invitations, alerts). `log` writes mails to the log instead of sending them.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=jogger@example.com

# Optional
JOGGER_METRICS_TOKEN=
JOGGER_LOCAL_HOST=false
JOGGER_LOCAL_HOST_TOKEN=
JOGGER_HTTP_PORT=8000
JOGGER_REVERB_PORT=8080
