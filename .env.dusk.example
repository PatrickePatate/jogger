# Environment for the browser (Dusk) tests. Copy to .env.dusk.local (git-ignored); tests/Browser/run.sh loads it.
# Uses its own database: the browser tests migrate:fresh it, so never point this at a database you care about.
APP_NAME=Jogger
APP_ENV=testing
APP_KEY=base64:am9nZ2VyLWR1c2stdGVzdC1rZXktbm90LXNlY3JldCE=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=jogger_dusk
DB_USERNAME=jogger
DB_PASSWORD=secret
DB_URL=

# Redis: dev compose maps 6380, CI service uses 6379.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_PREFIX=jogger_dusk_

SESSION_DRIVER=file
CACHE_STORE=array
QUEUE_CONNECTION=sync
LOG_CHANNEL=single
MAIL_MAILER=log

# Reverb: the app publishes to REVERB_HOST:REVERB_PORT, browsers connect to REVERB_PUBLIC_*.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=jogger-dusk
REVERB_APP_KEY=jogger-dusk-key
REVERB_APP_SECRET=jogger-dusk-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8081
REVERB_SCHEME=http
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8081
REVERB_PUBLIC_HOST=127.0.0.1
REVERB_PUBLIC_PORT=8081
REVERB_PUBLIC_SCHEME=http

# Local only: Chrome binary when there is no system Chrome (e.g. Playwright's). Leave unset in CI.
# DUSK_CHROME_BINARY=/home/you/.cache/ms-playwright/chromium-1217/chrome-linux64/chrome
